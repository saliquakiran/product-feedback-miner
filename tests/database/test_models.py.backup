class TestDigestReport:
    """Tests for DigestReport model."""
    
    def test_digest_report_creation(self, test_session):
        """Test DigestReport model creation."""
        report = DigestReport(
            report_type="hourly",
            title="Hourly Feedback Digest",
            content="Summary of feedback received",
            summary="5 new issues, 3 bugs, 2 feature requests",
            period_start=datetime.utcnow(),
            period_end=datetime.utcnow(),
            top_clusters=["cluster1", "cluster2"],
            delivery_status="pending",
            delivery_method="slack",
            delivery_recipients=["#product-feedback"]
        )
        
        test_session.add(report)
        test_session.commit()
        
        assert report.id is not None
        assert report.report_type == "hourly"
        assert "cluster1" in report.top_clusters
        assert report.delivery_status == "pending"
        assert report.delivery_method == "slack"

class TestDatabaseConstraints:
    """Tests for database constraints and relationships."""
    
    def test_foreign_key_constraints(self, test_session):
        """Test foreign key constraints work properly."""
        # Test that we can create a ProcessedDocument with valid foreign key
        raw_feedback = RawFeedback(
            source_type=SourceType.GITHUB_ISSUE,
            source_id="12345",
            url="https://github.com/user/repo/issues/123",
            content="Test content",
            timestamp=datetime.utcnow()
        )
        test_session.add(raw_feedback)
        test_session.commit()
        
        processed_doc = ProcessedDocument(
            raw_feedback_id=raw_feedback.id,
            title="Test Document",
            body="Test body",
            author="testuser",
            timestamp=datetime.utcnow(),
            url="https://github.com/user/repo/issues/123"
        )
        test_session.add(processed_doc)
        test_session.commit()
        
        assert processed_doc.id is not None
        assert processed_doc.raw_feedback_id == raw_feedback.id
        assert processed_doc.raw_feedback == raw_feedback

if __name__ == "__main__":
    pytest.main([__file__, "-v"])
